
# Student Performance Tracker

students = []

n = int(input("Enter number of students: "))

for i in range(n):
    print("\nEnter details for Student", i + 1)

    name = input("Student Name: ")

    m1 = float(input("Enter Subject 1 marks: "))
    m2 = float(input("Enter Subject 2 marks: "))
    m3 = float(input("Enter Subject 3 marks: "))

    total = m1 + m2 + m3
    percentage = total / 3

    if min(m1, m2, m3) < 0 or max(m1, m2, m3) > 100:
        print("Invalid marks! Enter marks between 0 and 100.")
        continue

    if min(m1, m2, m3) < 35:
        grade = "F"
        result = "Fail"
    elif percentage >= 90:
        grade = "A"
        result = "Pass"
    elif percentage >= 75:
        grade = "B"
        result = "Pass"
    elif percentage >= 60:
        grade = "C"
        result = "Pass"
    else:
        grade = "D"
        result = "Pass"

    students.append(
        [name, total, percentage, grade, result]
    )

print("\n--- STUDENT PERFORMANCE REPORT ---")

for s in students:
    print("\nName:", s[0])
    print("Total Marks:", s[1], "/ 300")
    print("Percentage:", round(s[2], 2), "%")
    print("Grade:", s[3])
    print("Result:", s[4])
